# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/nexvia

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# AI Engine (Gemini) - optional. If absent, the app falls back to a
# template-based resume generator and a rule-based candidate matcher.
GEMINI_API_KEY=

# Firebase Cloud Messaging - optional. If absent, notifications are
# still stored/delivered in-app + via Socket.io, just not pushed to devices.
FCM_SERVER_KEY=
