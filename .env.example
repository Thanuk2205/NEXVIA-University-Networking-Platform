NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
# Gateway only: comma-separated actual reverse-proxy IP/CIDR addresses; empty distrusts forwarded IPs.
TRUST_PROXY=
# Local MongoDB process startup budget; allows Windows disk/journal recovery.
NEXVIA_MONGO_STARTUP_TIMEOUT_MS=120000
# Run npm run setup for local keys. Production supplies keys from its secret store.
USER_JWT_PUBLIC_KEY_FILE=.local/user-public.pem
USER_JWT_KEY_ID=identity-1
# Optional rotation registries map registered key IDs to public PEM strings.
# USER_JWT_PUBLIC_KEYS_JSON={...}
# SERVICE_KEY_ID=identity:2 (set separately for each service)
# SERVICE_PUBLIC_KEYS_JSON={...}
USER_JWT_PRIVATE_KEY_FILE=.local/user-private.pem
SERVICE_KEYS_DIR=.local
TOKEN_ENCRYPTION_KEY_FILE=.local/token-key.txt
# Each service needs its own database credential in production.
IDENTITY_MONGO_URI=mongodb://127.0.0.1:27027/nexvia_identity?replicaSet=nexvia
PROFILE_MONGO_URI=mongodb://127.0.0.1:27027/nexvia_profile?replicaSet=nexvia
OPPORTUNITY_MONGO_URI=mongodb://127.0.0.1:27027/nexvia_opportunity?replicaSet=nexvia
MATCHING_MONGO_URI=mongodb://127.0.0.1:27027/nexvia_matching?replicaSet=nexvia
COMMUNITY_MONGO_URI=mongodb://127.0.0.1:27027/nexvia_community?replicaSet=nexvia
NOTIFICATION_MONGO_URI=mongodb://127.0.0.1:27027/nexvia_notification?replicaSet=nexvia
CV_MONGO_URI=mongodb://127.0.0.1:27027/nexvia_cv?replicaSet=nexvia
# Gmail credentials are used only by notification-service. No email is sent without them.
GMAIL_SENDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_MIN_INTERVAL_MS=1000
# Gemini credentials are used only by cv-service; template generation needs no provider.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional Unicode PDF font (absolute path to a licensed TTF covering the user's script).
CV_FONT_PATH=
