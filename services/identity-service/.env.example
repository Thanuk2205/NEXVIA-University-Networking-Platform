NODE_ENV=development
PORT=5101
CLIENT_ORIGIN=http://localhost:5173
IDENTITY_MONGO_URI=mongodb://<service-user>:<password>@localhost:27027/nexvia_identity?replicaSet=nexvia
USER_JWT_PUBLIC_KEY=<public PEM from Identity>
SERVICE_PRIVATE_KEY=<this service private PEM>
SERVICE_PUBLIC_KEYS_JSON=<JSON of service name to public PEM>
SERVICE_URLS_JSON=<JSON of service name to HTTPS internal URL>
USER_JWT_PRIVATE_KEY=<Identity private PEM>
TOKEN_ENCRYPTION_KEY=<64 hex characters>
